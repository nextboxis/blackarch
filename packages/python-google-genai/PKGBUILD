pkgname=python-google-genai
_pkgname=google_genai
pkgver=2.22.0
pkgrel=1
pkgdesc='GenAI Python SDK.'
arch=('any')
url='https://pypi.org/project/google-genai/#files'
license=('MIT')
depends=('python' 'python-anyio' 'python-google-auth' 'python-httpx'
         'python-pydantic' 'python-requests' 'python-tenacity'
         'python-websockets' 'python-typing_extensions' 'python-distro'
         'python-sniffio' 'python-aiohttp')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('218529064a0fa0a505ef445103487f2c1a0e612ea2a9a7fe7a909cfc3b594609543825bdeda6f3d3535d34a350619894a34c097cdb4634bfcff9d8fb5dbf85e8')

prepare() {
  cd "$_pkgname-$pkgver"

  sed -i 's/, "twine>=6.1.0", "packaging>=24.2", "pkginfo>=1.12.0"//g' \
    pyproject.toml
}

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

